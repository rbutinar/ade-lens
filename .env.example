# ade-lens — copy to .env.local. MOCK-FIRST: with nothing set below, Report Lens runs end to end
# on synthetic reports and a deterministic planner (no Entra, no Power BI, no model key).

# --- Mock switch -------------------------------------------------------------
# "1" (default) = synthetic reports + mock planner.  "0" = the real wires below.
LENS_MOCK=1

# --- Entra confidential client (server-side OBO) -----------------------------
# Your OWN app registration: a SPA platform for browser sign-in, a client secret for the
# server-side On-Behalf-Of exchange, an exposed api scope, delegated Power BI permissions with
# admin consent. See docs/entra-setup.md. The reports themselves are listed in content/lens-estate.ts.
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=

# --- Browser sign-in (public values, safe to expose to the client) -----------
NEXT_PUBLIC_LENS_AUTH=0
NEXT_PUBLIC_PBI_CLIENT_ID=
NEXT_PUBLIC_PBI_TENANT_ID=
# api://<client-id>/access_as_user
NEXT_PUBLIC_LENS_API_SCOPE=

# --- The agent ---------------------------------------------------------------
ANTHROPIC_API_KEY=
LENS_AGENT_MODEL=claude-opus-5

# --- The door (middleware.ts) --------------------------------------------------
# A shared secret in front of /app and /api. Mandatory on Vercel (unset = 503), optional elsewhere.
# Open once with https://<host>/app?k=<secret>. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LENS_GATE_SECRET=

# --- Report catalogue on Databricks (optional) ---------------------------------
# Two Unity Catalog functions, lens_list_reports(p_module) / lens_find_report_page(p_term), in this
# schema. Unset = the file catalogue (content/lens-estate.ts) answers. Read as the user via Entra
# OBO on Azure Databricks (the app registration needs the delegated user_impersonation permission).
# DATABRICKS_HOST=https://adb-<id>.<n>.azuredatabricks.net
# LENS_CATALOG_WAREHOUSE_ID=
# LENS_CATALOG_SCHEMA=<catalog>.<schema>
# Development only, never in production (one broad identity for everyone):
# LENS_CATALOG_PROFILE=<a profile in ~/.databrickscfg>
# LENS_CATALOG_DEV_TOKEN=

# --- Store: saved chats + the interaction log ----------------------------------
# memory (default): this server process only, lost on restart.
# sqlserver: database ade_lens, schema lens, Windows auth (ODBC Driver 18).
#   Create it once:  sqlcmd -S localhost -E -C -i db/sqlserver/001_lens_store.sql
#   A configured store that cannot be reached FAILS visibly; it never falls back to memory.
LENS_STORE=memory
# Optional ODBC connection string for another instance/database.
LENS_SQLSERVER_CONNECTION=
